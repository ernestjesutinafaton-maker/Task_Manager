{% extends 'base.html.twig' %}

{% block title %}Modifier {{ toDo.title }}{% endblock %}

{% block body %}

<div class="container">

    <div class="app-header">

        <div>
            <h1>✏️ Modifier la tâche</h1>

            <p>
                Modifiez les informations de votre tâche.
            </p>
        </div>

        <a
            href="{{ path('app_to_do_show', { id: toDo.id }) }}"
            class="btn btn-secondary"
        >
            ← Retour
        </a>

    </div>


    <div class="todo-detail">

        {{ form_start(form) }}

            {{ form_row(form.title) }}

            {{ form_row(form.content) }}

            {{ form_row(form.status) }}

            {{ form_row(form.AssignedTo) }}

            {{ form_row(form.date) }}

            <div style="margin-top: 20px;">

                {{ form_row(form.save, {
                    'label': '💾 Enregistrer les modifications'
                }) }}

            </div>

        {{ form_end(form) }}

    </div>

</div>

{% endblock %}